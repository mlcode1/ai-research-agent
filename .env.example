# ===== LLM 配置（必填）=====
# 默认 DeepSeek，便宜好用，国内访问方便
# 也可换成 OpenAI / 通义千问 / Moonshot 等 OpenAI 兼容 API
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1

# ===== 搜索配置（可选）=====
# 不填 TAVILY_API_KEY 则默认用 Bing 中国（免费免 key）
# 填了用 Tavily（更稳定，需要去 tavily.com 注册免费 key）
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=5

# ===== 微信公众号配置（可选）=====
# 填写后报告生成完毕会自动推送到草稿箱（不会自动发布）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 是否启用微信发布功能（true/false）
WECHAT_PUBLISH=true
# 是否自动生成封面图（false 则使用 Pillow 本地生成）
WECHAT_AUTO_COVER=true

# ===== 封面图生成配置（可选）=====
# 生成方式：auto（自动选择）/ openai_compatible / dashscope / pillow
# auto 模式会优先尝试 AI 生成，失败则自动降级到 Pillow
COVER_IMAGE_PROVIDER=auto
# OpenAI 兼容 API（支持 DashScope 通义万相、SiliconFlow 等）
COVER_IMAGE_API_KEY=
COVER_IMAGE_BASE_URL=
COVER_IMAGE_MODEL=
# 封面图风格描述（用于 AI 生成）
COVER_IMAGE_STYLE=简约、扁平设计、柔和渐变背景、干净现代

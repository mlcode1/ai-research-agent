# ===== LLM 配置（必填）=====
# 默认 DeepSeek，便宜好用，国内访问方便
# 也可换成 OpenAI / 通义千问 / Moonshot 等 OpenAI 兼容 API
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1

# ===== 搜索配置（可选）=====
# 不填 TAVILY_API_KEY 则用 DuckDuckGo 免费搜索
# 填了用 Tavily（更稳定，需要去 tavily.com 注册免费 key）
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=5
